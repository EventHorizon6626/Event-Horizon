# =============================================================================
# LLM PROVIDER API KEYS (TradingAgents Compatible)
# =============================================================================
# Only configure the providers you want to use. Ollama is FREE (runs locally).

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# xAI (Grok) - https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# OpenRouter (multi-model) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama (Local - FREE, no API key needed)
# Install: https://ollama.com/download
# Run: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM Provider (openai, anthropic, google, xai, openrouter, ollama)
DEFAULT_LLM_PROVIDER=openai

# Default Models (TradingAgents dual-LLM architecture)
DEFAULT_DEEP_THINK_MODEL=gpt-4o
DEFAULT_QUICK_THINK_MODEL=gpt-4o-mini

# =============================================================================
# DATA API KEYS
# =============================================================================

# NewsAPI.org credentials (only needed if ENABLE_NEWS_AGENT=true)
# Get your free API key at: https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# Massive.com API key (only needed if USE_MASSIVE_API=true)
# Get your API key at: https://massive.com/dashboard
MASSIVE_API_KEY=your_massive_api_key_here

# Chart Data Source
# Set to "true" to use Massive.com, "false" for Yahoo Finance (default)
USE_MASSIVE_API=false

# Agent Configuration - Enable/Disable Agents
# Set to "true" to enable, "false" to disable
ENABLE_NEWS_AGENT=false      # NewsAgent - Costs money (NewsAPI.org has rate limits)
ENABLE_REPORT_AGENT=true     # ReportAgent - Free (Yahoo Finance)
ENABLE_CHART_AGENT=true      # ChartAgent - Free (Yahoo Finance OHLCV data)

# Agent Settings
MAX_ARTICLES_PER_STOCK=20
DAYS_BACK=7

# API Server Configuration
# Use 127.0.0.1 for localhost-only (recommended when behind proxy)
# Use 0.0.0.0 to expose to external network (for direct access)
API_HOST=127.0.0.1
API_PORT=5000

# Logging
LOG_LEVEL=INFO
