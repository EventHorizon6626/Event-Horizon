# =============================================================================
# LLM PROVIDER API KEYS (TradingAgents Compatible)
# =============================================================================
#
# PROVIDER COST COMPARISON:
# ┌────────────────┬─────────┬───────────────────────────────────┐
# │ Provider       │ API Key │ Cost                              │
# ├────────────────┼─────────┼───────────────────────────────────┤
# │ Google Gemini  │ Yes     │ FREE tier available (recommended) │
# │ Ollama (Local) │ No      │ FREE (electricity only)           │
# │ OpenAI         │ Yes     │ ~$2.50-15/1M tokens               │
# │ Anthropic      │ Yes     │ ~$3-15/1M tokens                  │
# │ xAI            │ Yes     │ ~$2-10/1M tokens                  │
# │ OpenRouter     │ Yes     │ Varies by model                   │
# └────────────────┴─────────┴───────────────────────────────────┘
#
# =============================================================================
# OPTION 1: OLLAMA (FREE - Recommended for development)
# =============================================================================
# Ollama runs models locally on your GPU. No API key needed!
#
# Installation:
#   curl -fsSL https://ollama.com/install.sh | sh
#
# Pull models:
#   ollama pull llama3.1:8b      # Quick think (5GB, runs on most GPUs)
#   ollama pull llama3.3:70b     # Deep think (40GB, needs 48GB+ VRAM)
#   ollama pull deepseek-r1:14b  # Good balance (9GB)
#
# Ollama runs automatically on localhost:11434
#
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# OPTION 2: PAID API PROVIDERS (For production / better quality)
# =============================================================================
# Only configure the providers you want to use.

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google (Gemini) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# xAI (Grok) - https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# OpenRouter (access multiple models via single API) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================================================
# DEFAULT LLM CONFIGURATION
# =============================================================================
# TradingAgents uses dual-LLM architecture:
#   - Deep Think: Complex reasoning, synthesis, debates (slower, smarter)
#   - Quick Think: Rapid tasks, data processing (faster, cheaper)

# Default provider: ollama, openai, anthropic, google, xai, openrouter
DEFAULT_LLM_PROVIDER=google

# Default models - Google Gemini (FREE tier available)
DEFAULT_DEEP_THINK_MODEL=gemini-1.5-pro
DEFAULT_QUICK_THINK_MODEL=gemini-2.0-flash

# Alternative configurations:
# For Ollama (FREE, local):
# DEFAULT_LLM_PROVIDER=ollama
# DEFAULT_DEEP_THINK_MODEL=llama3.3:70b
# DEFAULT_QUICK_THINK_MODEL=llama3.1:8b

# For OpenAI (PAID):
# DEFAULT_LLM_PROVIDER=openai
# DEFAULT_DEEP_THINK_MODEL=gpt-4o
# DEFAULT_QUICK_THINK_MODEL=gpt-4o-mini

# =============================================================================
# DATA API KEYS
# =============================================================================

# Tavily API key (primary news search) — https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Exa API key (fallback news search) — https://exa.ai/
EXASEARCH_API_KEY=your_exa_api_key_here

# Massive.com API key (only needed if USE_MASSIVE_API=true)
# Get your API key at: https://massive.com/dashboard
MASSIVE_API_KEY=your_massive_api_key_here

# Chart Data Source
# Set to "true" to use Massive.com, "false" for Yahoo Finance (default)
USE_MASSIVE_API=false

# Agent Configuration - Enable/Disable Agents
# Set to "true" to enable, "false" to disable
ENABLE_NEWS_AGENT=false      # NewsAgent - Costs money (NewsAPI.org has rate limits)
ENABLE_REPORT_AGENT=true     # ReportAgent - Free (Yahoo Finance)
ENABLE_CHART_AGENT=true      # ChartAgent - Free (Yahoo Finance OHLCV data)

# Agent Settings
MAX_ARTICLES_PER_STOCK=20
DAYS_BACK=7

# API Server Configuration
# Use 127.0.0.1 for localhost-only (recommended when behind proxy)
# Use 0.0.0.0 to expose to external network (for direct access)
API_HOST=127.0.0.1
API_PORT=5000

# Logging
LOG_LEVEL=INFO
