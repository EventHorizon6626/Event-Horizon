[Unit]
Description=Event Horizon AI API Service
After=network.target

[Service]
Type=simple
User=vytrieu
WorkingDirectory=/home/vytrieu/EventHorizon/Event-Horizon-AI
Environment="PATH=/home/vytrieu/EventHorizon/Event-Horizon-AI/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/vytrieu/EventHorizon/Event-Horizon-AI/venv/bin/uvicorn api_server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
