# =============================================================================
# PRODUCTION ENVIRONMENT - Used by Docker
# =============================================================================

# LLM Provider - Google Gemini (FREE tier)
GOOGLE_API_KEY=your_production_google_api_key_here

# Default LLM Configuration
DEFAULT_LLM_PROVIDER=google
DEFAULT_DEEP_THINK_MODEL=gemini-2.0-flash
DEFAULT_QUICK_THINK_MODEL=gemini-2.0-flash

# Ollama (optional - for local inference in Docker)
OLLAMA_BASE_URL=http://localhost:11434

# Data API Keys
NEWS_API_KEY=your_newsapi_key_here
MASSIVE_API_KEY=your_massive_api_key_here
USE_MASSIVE_API=false

# Agent Configuration
ENABLE_NEWS_AGENT=false
ENABLE_REPORT_AGENT=true
ENABLE_CHART_AGENT=true

# Agent Settings
MAX_ARTICLES_PER_STOCK=20
DAYS_BACK=7

# API Server Configuration - Docker uses 0.0.0.0 to expose to network
API_HOST=0.0.0.0
API_PORT=5000

# Logging
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
